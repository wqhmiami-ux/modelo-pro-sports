
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Modelo PRO Sports</title>
<style>
body{background:#0b1120;color:white;font-family:Arial;padding:18px}
h1{color:#72e6b1}
section{background:#172338;padding:16px;border-radius:12px;margin:15px 0}
input,select,button{width:100%;padding:12px;margin:7px 0;box-sizing:border-box;border-radius:8px}
button{background:#72e6b1;font-weight:bold;border:0}
input,select{background:#0b1120;color:white;border:1px solid #52627a}
</style>
</head>
<body>
<h1>🏆 Modelo PRO Sports</h1>
<p>Fútbol · NBA · MLB · NHL</p>
<section>
<h3>Analizar apuesta</h3>
<label>Deporte</label>
<select id="sport">
<option>Fútbol</option><option>NBA</option><option>MLB</option><option>NHL</option>
</select>
<label>Partido</label><input id="game" placeholder="Equipo A vs Equipo B">
<label>Mercado</label>
<select id="market">
<option>Ganador / ML</option><option>Hándicap</option>
<option>Over / Under</option><option>Ambos marcan</option>
<option>Córners</option><option>Tiros al arco</option>
<option>Puntos de jugador</option><option>Rebotes</option>
<option>Hits</option><option>Ponches</option><option>Goles NHL</option>
</select>
<label>Selección</label><input id="pick" placeholder="Ej. Más de 2.5 goles">
<label>Cuota americana</label><input id="odds" type="number" value="-110">
<label>Probabilidad estimada (%)</label><input id="prob" type="number" value="60" min="1" max="99">
<button onclick="analyze()">APOSTAR / NO APOSTAR</button>
<div id="result"></div>
</section>
<section>
<h3>Mi registro</h3>
<p>Esta primera versión es para probar el análisis. El registro de resultados lo añadiremos después.</p>
</section>
<script>
function analyze(){
let o=Number(document.getElementById('odds').value);
let p=Number(document.getElementById('prob').value);
let game=document.getElementById('game').value;
let pick=document.getElementById('pick').value;
if(!game||!pick||!o||p<=0||p>=100){alert('Completa el partido, selección, cuota y probabilidad.');return}
let implied=o>0?100/(o+100):Math.abs(o)/(Math.abs(o)+100);
let edge=p/100-implied;
let decision=edge>=0.03?'APOSTAR':'NO APOSTAR';
document.getElementById('result').innerHTML=
'<h2 style="color:'+(edge>=0.03?'#72e6b1':'#ff8585')+'">'+decision+'</h2>'+
'<p>Probabilidad estimada: '+p+'%</p>'+
'<p>Probabilidad implícita: '+(implied*100).toFixed(1)+'%</p>'+
'<p>EDGE: '+(edge*100).toFixed(1)+' puntos porcentuales</p>'+
'<small>La probabilidad la introduces tú; no es una predicción automática.</small>';
}
</script>
</body>
</html>
